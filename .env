# Odoo MCP Server Configuration
# Copy this file to .env and fill in your values for local development.
# All environment variables are optional except those marked (required).

# ============================================================================
# Odoo Connection (required)
# ============================================================================

# ODOO_URL (required)
# The base URL of your Odoo instance.
# Example: http://localhost:8069 or https://odoo.example.com
ODOO_URL=https://www.avware.io

# ODOO_DB (required)
# The database name in your Odoo instance.
# Example: odoo19
ODOO_DB=odoo

# ODOO_API_KEY (required for service auth mode)
# The API key for the service account.
# Only required when ODOO_MCP_AUTH_MODE is set to "service".
# Generate this in Odoo: Settings > Users & Companies > Users > [user] > API Keys
ODOO_API_KEY=3f9927cfffa3033795537094d47236f0c31193f1

# ODOO_TIMEOUT (default: 30s)
# How long to wait for Odoo API responses before timing out.
# Format: Go duration string (e.g., "30s", "5m", "1h")
ODOO_TIMEOUT=30s

# ============================================================================
# Transport Configuration
# ============================================================================

# ODOO_MCP_TRANSPORT (default: stdio)
# How the MCP server communicates with clients.
# Valid values:
#   - stdio: Single-session, local communication (default, recommended for Claude Desktop)
#   - http: Networked HTTP transport with streaming on /mcp endpoint
#   - sse: Legacy Server-Sent Events transport (SSE on /sse, POST on /message)
ODOO_MCP_TRANSPORT=stdio

# ODOO_MCP_ADDR (default: :8085)
# The address to listen on when using HTTP or SSE transport.
# Format: [host]:port
# Examples: :8085, localhost:8085, 0.0.0.0:8085
ODOO_MCP_ADDR=:8085

# ============================================================================
# Authentication Mode
# ============================================================================

# ODOO_MCP_AUTH_MODE (default: service)
# How the server authenticates requests to Odoo.
# Valid values:
#   - service: All MCP calls use the single ODOO_API_KEY (default, simpler)
#   - per-session: Each MCP client provides its own API key via X-Odoo-Api-Key header
ODOO_MCP_AUTH_MODE=service

# ============================================================================
# Guardrails (Security & Performance)
# ============================================================================

# ODOO_BLOCKED_MODELS (default: ir.rule, ir.model.access, res.users.apikeys)
# Comma-separated list of additional models that cannot be accessed via MCP.
# These are merged with the default blocked models (security-critical models).
# Default blocked models are always enforced:
#   - ir.rule: Security rules
#   - ir.model.access: Access control lists
#   - res.users.apikeys: API key management
# Example: ir.config_parameter,ir.cron
ODOO_BLOCKED_MODELS=

# ODOO_READ_ONLY (default: false)
# Set to true to allow only read operations (search, read, fields_get).
# Write operations (create, write, unlink, call) will be rejected.
# Valid values: true, false, 1, 0, yes, no, on, off (case-insensitive)
ODOO_READ_ONLY=false

# ODOO_RATE_LIMIT_RPS (default: 10)
# Maximum number of requests per second per session.
# Must be at least 1.
# Example: 10 allows up to 10 requests per second
ODOO_RATE_LIMIT_RPS=10

# ============================================================================
# Logging & Audit
# ============================================================================

# ODOO_LOG_LEVEL (default: info)
# Logging level for the server.
# Valid values: debug, info, warn, error
# Use "debug" for development, "info" for production
ODOO_LOG_LEVEL=info

# ODOO_AUDIT_LOG (default: true)
# Enable structured audit logging of all MCP operations.
# Audit logs record who called what, when, and the result.
# Valid values: true, false, 1, 0, yes, no, on, off (case-insensitive)
ODOO_AUDIT_LOG=true

# ODOO_AUDIT_FILE (default: empty, logs to stdout)
# Path to write audit logs to a file.
# If empty or not set, audit logs are written to stdout.
# Example: /var/log/odoo-mcp/audit.log
ODOO_AUDIT_FILE=
